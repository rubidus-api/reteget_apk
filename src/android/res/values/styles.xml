<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme: the platform light theme with compact buttons everywhere, including the
         ones built in code (the download queue). -->
    <style name="AppTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:buttonStyle">@style/CompactButton</item>
        <item name="android:checkboxStyle">@style/CompactCheckBox</item>
    </style>

    <style name="CompactCheckBox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/checkbox_compact</item>
        <!-- 22dp box + 6dp gap: before Android 4.2 the text padding must cover the box itself. -->
        <item name="android:paddingLeft">28dp</item>
    </style>

    <style name="CompactButton" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/btn_compact</item>
        <item name="android:textColor">@color/btn_compact_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <!-- A preset or queue action: a short word in a bordered compact button. -->
    <!-- Six of these (Latest Use Edit Up Dn Del) plus the check box fit a 320dp-wide phone. -->
    <style name="PresetAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/btn_compact_text</item>
        <item name="android:background">@drawable/btn_compact</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
