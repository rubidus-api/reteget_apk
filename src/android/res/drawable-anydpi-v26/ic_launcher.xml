<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from API 26 on. Older devices never see this file: the -v26 qualifier keeps
     them on the plain PNG in the density folders. The monochrome layer is the themed icon Android 13
     asks for: the system paints its opaque pixels (the lettering and the arrow) in the theme colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
