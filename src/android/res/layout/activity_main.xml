<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingBottom="8dp" />

        <!-- Download queue: at the top, hidden while empty. Rows are added in code. -->
        <LinearLayout
            android:id="@+id/layout_queue_section"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F2F6FA"
            android:padding="8dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txt_queue_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/queue_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#006699" />

                <Button
                    android:id="@+id/btn_queue_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/queue_clear_finished"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_queue_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_select_all" />

                <Button
                    android:id="@+id/btn_queue_delete_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/btn_danger_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_queue_list"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/target_url"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btn_paste_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_paste" />

            <Button
                android:id="@+id/btn_clear_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/btn_clear_url" />
        </LinearLayout>

        <EditText
            android:id="@+id/edit_url"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:hint="@string/url_hint"
            android:singleLine="false"
            android:maxLines="4"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Container for dynamically added template variable fields ({1}, {2}, etc.) -->
        <LinearLayout
            android:id="@+id/layout_variables"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_templates"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#006699"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/variables_fields"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txt_resolved_preview"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#555555"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Expected Checksum Input (optional), with Paste and Clear like the URL field -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lbl_checksum"
                android:textSize="13sp"
                android:textColor="#444444" />

            <Button
                android:id="@+id/btn_paste_checksum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_paste" />

            <Button
                android:id="@+id/btn_clear_checksum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/btn_clear_url" />
        </LinearLayout>

        <EditText
            android:id="@+id/edit_expected_checksum"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/checksum_hint"
            android:singleLine="true"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chk_insecure_ssl"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/chk_insecure"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/chk_pure_tls"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/chk_pure_tls"
            android:textSize="12sp"
            android:textColor="#1a237e"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/chk_auto_upgrade"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/chk_auto_upgrade"
            android:textSize="12sp"
            android:textColor="#1b5e20"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_download"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/btn_download"
                android:textStyle="bold" />

            <!-- Saves the URL above (template and version) as a preset. -->
            <Button
                android:id="@+id/btn_add_preset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/btn_add_preset" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/btn_cancel"
                android:enabled="false" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txt_progress_details"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="13sp"
            android:textColor="#333333"
            android:paddingBottom="6dp" />

        <!-- Checksum Result Area (shown after download) -->
        <LinearLayout
            android:id="@+id/layout_checksum_result"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#f0f4f8"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_checksum_result"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#222222"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_copy_hash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copy_hash"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_verify_hash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_verify_hash"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- APK Signature Result Area (shown for downloaded APKs) -->
        <LinearLayout
            android:id="@+id/layout_signature_result"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#f5f7f9"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_signature"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txt_signature_result"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#222222"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btn_copy_cert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_copy_cert"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_install"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_install"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="14dp" />

        <!-- Visual divider before Presets section at the bottom -->
        <View
            android:layout_width="fill_parent"
            android:layout_height="1dp"
            android:background="#d0d0d0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Presets Section at bottom -->
        <LinearLayout
            android:id="@+id/layout_presets_section"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_presets_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <!-- All settings (presets, options, signing keys) to and from a file. -->
                <Button
                    android:id="@+id/btn_settings_import"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_import" />

                <Button
                    android:id="@+id/btn_settings_export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/btn_export" />
            </LinearLayout>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_presets_hint"
                android:textSize="11sp"
                android:textColor="#777777"
                android:layout_marginBottom="6dp" />

            <!-- Batch operations bar: Select All & Delete Selected -->
            <LinearLayout
                android:id="@+id/layout_preset_batch"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_preset_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_select_all" />

                <Button
                    android:id="@+id/btn_delete_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/btn_danger_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_no_presets"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_presets_msg"
                android:textSize="12sp"
                android:textColor="#888888"
                android:visibility="gone"
                android:padding="8dp" />

            <!-- Dynamic container for preset rows -->
            <LinearLayout
                android:id="@+id/layout_presets_list"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
