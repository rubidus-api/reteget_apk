# Allowlist: this repository publishes only what a person needs to build the app,
# plus the README and the screenshots it shows. Everything else — working notes,
# operating docs, plans, test scaffolding, private material, build output, release
# artifacts (they live on the Releases page) — stays local or in the private sidecar.
#
# Ignore everything, then re-allow the public surface, so a new file is never
# published by accident.

/*

!/.gitignore
!/README.md
!/README.ko.md
!/LICENSE

# Sources and resources needed to compile the APK.
!/src/

# Build scripts needed to produce the APK.
!/scripts/
/scripts/*
!/scripts/env.sh
!/scripts/build.sh
!/scripts/test.sh
!/scripts/add-to-zip.py
!/scripts/emulator.sh
!/scripts/verify-kitkat.sh

# The screenshots the README embeds, and the F-Droid build recipe with its instructions.
!/docs/
/docs/*
!/docs/screenshots/
!/docs/fdroid/

# Store metadata F-Droid reads from the source tree (title, descriptions, images, changelogs).
!/fastlane/

# Tests
!/tests/

# The generator of the launcher icon PNGs (run only when the design changes).
!/tools/
/tools/*
!/tools/make-icons.py

# Build outputs
build/
dist/
*.keystore
scripts/env.local.sh
